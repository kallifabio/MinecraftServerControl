{
  "name": "minecraft-server-control",
  "productName": "Minecraft Server Manager",
  "author": "Coreframe Studio",
  "description": "Minecraft Server Manager für Remote-Serververwaltung mit SSH",
  "version": "1.0.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "lint": "eslint .",
    "clean": "rimraf dist",
    "build": "npm run clean && electron-builder"
  },
  "build": {
    "appId": "de.coreframe.MinecraftServerManager",
    "productName": "Minecraft Server Manager",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kallifabio",
      "repo": "MinecraftServerControl"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "jars/",
      "data/",
      "!jars/**/*",
      "!data/**/*",
      "data/.keep",
      "jars/.keep"
    ],
    "win": {
      "target": "nsis",
      "icon": "renderer/images/logo256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minecraft Server Manager"
    }
  },
  "devDependencies": {
    "electron": "^36.5.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ssh2": "^1.16.0"
  }
}
